[Unit]
Description=homelab-sentinel: Decider-gated event triage with Bedrock analysis
After=network-online.target docker.service strands-decider-int8.service
Wants=network-online.target strands-decider-int8.service

[Service]
User=h4n
WorkingDirectory=/home/h4n/homelab-sentinel
ExecStart=/home/h4n/homelab-sentinel/.venv/bin/python -m sentinel.main
Restart=always
RestartSec=10
MemoryMax=1G
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
